{
  "name": "larkmessage-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --experimental-sqlite --import tsx/esm --watch src/index.ts",
    "build": "tsc",
    "start": "node --experimental-sqlite dist/index.js",
    "cli:list-chats": "node --experimental-sqlite --import tsx/esm src/scripts/list-chats.ts",
    "cli:send": "node --experimental-sqlite --import tsx/esm src/scripts/send-message.ts",
    "cli:sync-contacts": "node --experimental-sqlite --import tsx/esm src/scripts/sync-contacts.ts",
    "cli:fix-topics": "node --experimental-sqlite --import tsx/esm src/scripts/fix-topics.ts",
    "cli:sync-chats": "node --experimental-sqlite --import tsx/esm -e \"import('./src/services/syncChats.js').then(m=>m.syncChats()).then(r=>{ console.log(r); process.exit(0); })\""  
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.4.5"
  }
}
